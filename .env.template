# ─────────────────────────────────────────────────────────────────────────────
# ENTORNO
# development | testing | production
# ─────────────────────────────────────────────────────────────────────────────
FLASK_ENV=production

# ─────────────────────────────────────────────────────────────────────────────
# SEGURIDAD
# Generar con: python -c "import secrets; print(secrets.token_hex(32))"
# ─────────────────────────────────────────────────────────────────────────────
SECRET_KEY=
JWT_SECRET_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# BASE DE DATOS — Azure Database for PostgreSQL
# Formato: postgresql://user%40server:password@server.postgres.database.azure.com:5432/dbname
# SSL requerido por Azure — ya configurado en ProductionConfig (sslmode=require)
# ─────────────────────────────────────────────────────────────────────────────
DATABASE_URL=

# ─────────────────────────────────────────────────────────────────────────────
# CORS — dominio(s) del frontend separados por coma
# Ejemplo: https://app.worldcuphub.online,https://www.worldcuphub.online
# ─────────────────────────────────────────────────────────────────────────────
CORS_ORIGINS=https://app.worldcuphub.online

# ─────────────────────────────────────────────────────────────────────────────
# CACHE — AWS ElastiCache Redis (opcional; fallback a dict en memoria)
# ─────────────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─────────────────────────────────────────────────────────────────────────────
# NOTIFICACIONES PUSH — Firebase Cloud Messaging
# Obtener: Firebase Console → Project Settings → Service Accounts → Generate key
# En producción: almacenar el JSON en AWS Secrets Manager y mapear aquí
# ─────────────────────────────────────────────────────────────────────────────
FIREBASE_SERVICE_ACCOUNT_JSON=
GOOGLE_APPLICATION_CREDENTIALS=

# ─────────────────────────────────────────────────────────────────────────────
# EMAIL — AWS SES
# El remitente debe ser una identidad verificada en SES (dominio o email).
# En producción las credenciales vienen del rol IAM del task ECS — no se hardcodean.
# En local dev boto3 usa ~/.aws/credentials automáticamente.
# Para Docker local: añade AWS_ACCESS_KEY_ID y AWS_SECRET_ACCESS_KEY a este archivo.
# ─────────────────────────────────────────────────────────────────────────────
SES_FROM_EMAIL=informacion@worldcuphub.online
# AWS_ACCESS_KEY_ID=        # solo para Docker local; en prod usa el rol IAM
# AWS_SECRET_ACCESS_KEY=    # solo para Docker local; en prod usa el rol IAM

# ─────────────────────────────────────────────────────────────────────────────
# APIS EXTERNAS
# ─────────────────────────────────────────────────────────────────────────────
FOOTBALL_API_URL=https://api.football-data.org/v4
FOOTBALL_API_KEY=
NEWS_API_KEY=
THESPORTSDB_API_KEY=3

# ─────────────────────────────────────────────────────────────────────────────
# PROXY DE IMÁGENES — hosts permitidos (separados por coma)
# ─────────────────────────────────────────────────────────────────────────────
PROXY_ALLOWED_HOSTS=crests.football-data.org,media.api-sports.io,upload.wikimedia.org,img.mlbstatic.com,newsapi.org

# ─────────────────────────────────────────────────────────────────────────────
# AWS — región y credenciales
# En ECS/Lambda las credenciales se inyectan via rol IAM; no hardcodear en prod.
# ─────────────────────────────────────────────────────────────────────────────
AWS_DEFAULT_REGION=us-east-1
