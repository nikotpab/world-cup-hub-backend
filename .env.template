# ─────────────────────────────────────────────────────────────────────────────
# SERVER
# ─────────────────────────────────────────────────────────────────────────────
SECRET_KEY=
JWT_SECRET_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# DATABASE
# ─────────────────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///instance/dev.db
# Producción: postgresql://user:pass@host:5432/dbname

# ─────────────────────────────────────────────────────────────────────────────
# CACHE — Redis
# Si Redis no está disponible el sistema usa un dict en memoria como fallback.
# ─────────────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─────────────────────────────────────────────────────────────────────────────
# NOTIFICACIONES PUSH — Firebase Cloud Messaging (FCM)
# Obtener en: Firebase Console → Project Settings → Service Accounts
#             → Generate new private key
#
# Opción A (recomendada para producción/nube): pega el JSON completo
FIREBASE_SERVICE_ACCOUNT_JSON=
# Opción B (desarrollo local): ruta al archivo .json descargado
GOOGLE_APPLICATION_CREDENTIALS=
# ─────────────────────────────────────────────────────────────────────────────

# ─────────────────────────────────────────────────────────────────────────────
# NOTIFICACIONES EMAIL — SendGrid
# Obtener en: https://app.sendgrid.com/settings/api_keys
# Verificar el dominio remitente en: Sender Authentication
# ─────────────────────────────────────────────────────────────────────────────
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=no-reply@worldcuphub.online

# ─────────────────────────────────────────────────────────────────────────────
# APIS EXTERNAS
# ─────────────────────────────────────────────────────────────────────────────

# football-data.org — partidos, equipos, clasificaciones
# Plan gratuito: 10 req/min. Obtener en https://www.football-data.org/client/register
FOOTBALL_API_URL=https://api.football-data.org/v4
FOOTBALL_API_KEY=

# NewsAPI — noticias del Mundial
# Plan gratuito: 100 req/día. Obtener en https://newsapi.org/register
NEWS_API_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# SMTP (alternativa a SendGrid para correos simples)
# ─────────────────────────────────────────────────────────────────────────────
SMTP_SERVER=smtp.hostinger.com
SMTP_PORT=465
SMTP_EMAIL=
SMTP_PASSWORD=
